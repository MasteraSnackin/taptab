{
  "name": "taptab",
  "version": "0.1.0",
  "private": true,
  "description": "Claim, fund and settle shared bills together on Monad.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "verify:local": "npm test && npm run lint && npm run typecheck && npm run test:e2e && npm --prefix contracts test && npm --prefix contracts run rehearse:local && npm --prefix contracts run benchmark:gas"
  },
  "dependencies": {
    "@ethersproject/sha2": "^5.8.0",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-ethers": "^1.8.23",
    "@x402/core": "2.21.0",
    "@x402/evm": "2.21.0",
    "@x402/extensions": "2.21.0",
    "@x402/svm": "2.21.0",
    "ethers": "^6.17.0",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "viem": "^2.55.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.51.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0",
    "wrangler": "^4.119.0"
  },
  "overrides": {
    "axios": "1.18.0",
    "undici": "7.29.0",
    "ws": "8.21.0"
  },
  "type": "module"
}
