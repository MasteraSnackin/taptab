# TapTab deployment. Leave both values blank for preview mode; set both together for live mode.
NEXT_PUBLIC_TAPTAB_ADDRESS=
NEXT_PUBLIC_TAPTAB_BILL_ID=

# Server-only readiness probe RPC. Defaults to the canonical public Testnet RPC.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Optional HTTPS fallback without URL credentials or fragments, used by readiness only.
MONAD_TESTNET_FALLBACK_RPC_URL=

# Optional HTTPS fallback without URL credentials or fragments for browser reads/simulations.
# Wallet writes use the connected wallet provider and never use this endpoint.
NEXT_PUBLIC_MONAD_TESTNET_FALLBACK_RPC_URL=

# Exact public HTTPS origin used by invite links and wallet verification metadata.
NEXT_PUBLIC_SITE_URL=

# Public project identifier from dashboard.reown.com. Enables wallet connections.
NEXT_PUBLIC_REOWN_PROJECT_ID=
